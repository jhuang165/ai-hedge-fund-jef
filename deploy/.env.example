# Copy to .env (same directory) and fill in.

# Secret shared between the two containers; the reporter sends it to the wrapper.
PROXY_API_KEY=change-me-long-random

# What the dashboard asks for (HTTP basic auth). The server is on the public internet.
REPORTER_USER=desk
REPORTER_PASSWORD=change-me-too

# Which model the wrapper runs (must be one your Codex account can use;
# GET /v1/models on the wrapper lists them).
REPORTER_MODEL=gpt-6-luna
# Per-request reasoning override: low | medium | high. Empty = the wrapper's default below.
REPORTER_REASONING=
CODEX_REASONING_EFFORT=medium

# Cadence. Every INTERVAL minutes inside ACTIVE_HOURS on weekdays (TIMEZONE),
# every OFF_HOURS minutes otherwise (0 = never outside the window).
REPORTER_INTERVAL_MINUTES=60
REPORTER_OFF_HOURS_INTERVAL_MINUTES=240
REPORTER_ACTIVE_HOURS=07:00-20:00
REPORTER_TIMEZONE=America/New_York

# The watchlist the database is seeded with on first boot; edit later in the UI.
REPORTER_SYMBOLS=SMCI,NVDA,QCOM,GOOG,AAPL,AMZN,MSFT,META,WFC,MU

# Concurrent Codex runs (each is a `codex exec` process; 2 is plenty on a small box).
REPORTER_PARALLEL=2
# Seconds one brief may take before it is abandoned.
CODEX_TIMEOUT=900

# Host port for the dashboard.
REPORTER_PORT=8788
# Localhost port the wrapper is published on, for a reporter running on the host (mac-publish.sh).
CODEX_WRAPPER_PORT=8020

# UID/GID the wrapper container runs as; must own ./codex-home so Codex can refresh auth.json.
HOST_UID=1000
HOST_GID=1000
